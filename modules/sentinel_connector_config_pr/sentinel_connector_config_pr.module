<?php

/**
 * @file
 * Opens a configuration pull request on GitHub or GitLab.
 */

use Drupal\sentinel_connector_config_pr\ConfigPrRunner;
use Drupal\sentinel_connector_config_pr\PullRequestTracker;

/**
 * Implements hook_cron().
 *
 * Does nothing unless cron runs are on in this module's settings (off by
 * default) and the Sentinel Connector's cron reporting is on, which the README
 * keeps to production. Then runs once the interval has passed.
 */
function sentinel_connector_config_pr_cron(): void {
  try {
    \Drupal::service(ConfigPrRunner::class)->cron();
  }
  catch (\Throwable $error) {
    try {
      \Drupal::logger('sentinel_connector')->error('Configuration pull request cron failed with @class.', ['@class' => get_class($error)]);
    }
    catch (\Throwable) {
      // Logging must not abort the remaining cron hooks.
    }
  }
}

/**
 * Implements hook_sentinel_connector_config_drift_alter().
 *
 * Adds the open configuration pull request to the drift report. It is read
 * from State only, so building the report never calls the Git host.
 *
 * @phpstan-param array<string, mixed> $drift
 */
function sentinel_connector_config_pr_sentinel_connector_config_drift_alter(array &$drift): void {
  $pull = \Drupal::service(PullRequestTracker::class)->openPullRequest();
  if ($pull !== NULL && preg_match('#^https?://#', $pull['url'])) {
    $drift['export_pull_request'] = $pull;
  }
}
