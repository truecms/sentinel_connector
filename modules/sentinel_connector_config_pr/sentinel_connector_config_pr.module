<?php

/**
 * @file
 * Opens a configuration pull request on GitHub or GitLab.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\sentinel_connector_config_pr\Hook\ConfigPrHooks;

/**
 * Implements hook_cron() for Drupal versions without object-oriented hooks.
 */
#[LegacyHook]
function sentinel_connector_config_pr_cron(): void {
  \Drupal::service(ConfigPrHooks::class)->cron();
}

/**
 * Implements hook_sentinel_connector_config_drift_alter() for Drupal 10.
 *
 * @param array<string, mixed> $drift
 *   The configuration drift block.
 */
#[LegacyHook]
function sentinel_connector_config_pr_sentinel_connector_config_drift_alter(array &$drift): void {
  \Drupal::service(ConfigPrHooks::class)->configDriftAlter($drift);
}
