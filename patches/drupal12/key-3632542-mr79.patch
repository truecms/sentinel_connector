diff --git a/.deprecation-ignore.txt b/.deprecation-ignore.txt
new file mode 100644
index 0000000000000000000000000000000000000000..9c5ee98d0bee39c23c853a62e4abaa99358273c9
--- /dev/null
+++ b/.deprecation-ignore.txt
@@ -0,0 +1,8 @@
+# This file contains patterns to be ignored while testing for use of
+# deprecated code. GitLab CI appends core's .deprecation-ignore.txt to it.
+# See https://www.drupal.org/node/3285162 for more details.
+
+# Return type deprecations in key's own classes. Adding native return types to
+# these extendable classes would break downstream subclasses, so they wait for
+# a new major version of key.
+%Method "[^"]+::[^"]+\(\)" might add "[^"]+" as a native return type declaration in the future\. Do the same in (?:implementation|child class) "Drupal\\key(?:_test)?\\[^"]+" now to avoid errors or add an explicit @return annotation to suppress this message%
diff --git a/.gitlab-ci.yml b/.gitlab-ci.yml
index bcaf7e67ed21315f7028f7d1ed3b6a940c9646ce..3f8968f43711401312f2a0365f4c38b8688a20e0 100644
--- a/.gitlab-ci.yml
+++ b/.gitlab-ci.yml
@@ -40,3 +40,13 @@ variables:
   OPT_IN_TEST_NEXT_MINOR: 1
   OPT_IN_TEST_NEXT_MAJOR: 1
   OPT_IN_TEST_MAX_PHP: 1
+  # From core 11.5, use the project's deprecation ignore file; CI appends
+  # core's .deprecation-ignore.txt to it.
+  DRUPAL_DEPRECATION_FILTER_CONFIG: '{"projectIgnoreFile":"$CI_PROJECT_DIR/.deprecation-ignore.txt"}'
+
+# The templates run the previous major on its minimum PHP (8.1), whose Debian
+# bullseye images can no longer install packages. Run it on PHP 8.3 instead;
+# the phpstan and phpunit previous-major jobs inherit this.
+composer (previous major):
+  variables:
+    PHP_VERSION: '8.3'
