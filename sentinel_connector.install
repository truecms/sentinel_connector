<?php

/**
 * @file
 * Install, update and requirements hooks for Sentinel Connector.
 */

use Drupal\Core\Hook\Attribute\LegacyRequirementsHook;
use Drupal\sentinel_connector\ApiBaseUrlResolver;
use Drupal\sentinel_connector\ApiKeyMigrator;
use Drupal\sentinel_connector\ApiKeyResolver;
use Drupal\sentinel_connector\Hook\SentinelHooks;
use Drupal\sentinel_connector\SettingsUpgrade;
use Drupal\sentinel_connector\SyncService;

/**
 * Implements hook_requirements().
 *
 * Supports Drupal versions before the runtime requirements hook.
 *
 * @phpstan-return array<string, array<string, mixed>>
 *   Runtime requirement entries.
 */
#[LegacyRequirementsHook]
function sentinel_connector_requirements(string $phase): array {
  if ($phase !== 'runtime') {
    return [];
  }
  return (new SentinelHooks(\Drupal::getContainer()))->runtimeRequirements();
}

/**
 * Remove the push interval setting and record the last accepted push.
 */
function sentinel_connector_update_10001(): string {
  // Cron now sends at most one push an hour; Sentinel decides the rest.
  $config = \Drupal::configFactory()->getEditable('sentinel_connector.settings');
  if ($config->get('cron_interval') !== NULL) {
    $config->clear('cron_interval')->save();
  }

  // The status report reads the last accepted push from its own state key.
  $state = \Drupal::state();
  $lastSuccess = (int) $state->get('sentinel_connector.last_sync_time', 0);
  if ($lastSuccess > 0 && !$state->get(SyncService::STATE_LAST_ACCEPTED_TIME)) {
    $state->set(SyncService::STATE_LAST_ACCEPTED_TIME, $lastSuccess);
  }
  /** @var \Drupal\sentinel_connector\SyncService $sync */
  $sync = \Drupal::service(SyncService::class);
  $sync->markConfigured();

  return (string) t('Removed the Sentinel Connector push interval setting. Cron now sends at most one push an hour.');
}

/**
 * Remove the unused site token setting.
 */
function sentinel_connector_update_10002(): string {
  // Sentinel authenticates with the API key only; the key is left untouched.
  $config = \Drupal::configFactory()->getEditable('sentinel_connector.settings');
  if ($config->get('site_token') !== NULL) {
    $config->clear('site_token')->save();
  }

  return (string) t('Removed the unused Sentinel Connector site token setting. The API key is unchanged.');
}

/**
 * Turn on configuration drift reporting.
 */
function sentinel_connector_update_10003(): string {
  // Only names and change types are sent, so drift is reported by default.
  $config = \Drupal::configFactory()->getEditable('sentinel_connector.settings');
  if ($config->get('report_config_drift') === NULL) {
    $config->set('report_config_drift', TRUE)->save();
  }

  return (string) t('Sentinel Connector now reports configuration drift: the names of changed configuration objects, never their values. Turn it off on the settings form.');
}

/**
 * Move an API key saved in State into a Key module key.
 */
function sentinel_connector_update_10004(): string {
  $config = \Drupal::configFactory()->getEditable('sentinel_connector.settings');
  if ($config->get('api_key_id') === NULL) {
    $config->set('api_key_id', '')->save();
  }

  /** @var \Drupal\sentinel_connector\ApiKeyMigrator $migrator */
  $migrator = \Drupal::service(ApiKeyMigrator::class);
  $id = $migrator->migrate();
  if ($id !== NULL) {
    return (string) t('Moved the Sentinel API key from State into the key "@id", which still stores it in the database. Change that key to a file, environment variable or vault provider. Export configuration afterwards (drush cex).', ['@id' => $id]);
  }
  if (is_string(\Drupal::state()->get(ApiKeyResolver::STATE_KEY))) {
    return (string) t('The Sentinel API key is still saved in State, which is deprecated. Enable the Key module to move it into a key, or select a key on the settings form.');
  }
  return (string) t('No Sentinel API key was saved in State. Nothing to move.');
}

/**
 * Remove the API base URL, site URL and site name; map the report scope.
 */
function sentinel_connector_update_10005(): string {
  $config = \Drupal::configFactory()->getEditable('sentinel_connector.settings');
  [$data, $customUrl] = SettingsUpgrade::apply($config->getRawData());
  $config->setData($data)->save();

  $messages = [(string) t('Sentinel Connector settings now hold the Site UUID, API key, report scope, configuration drift and platform versions only. Platform versions are still reported; turn this off on the settings form. The report scope is now "@scope".', ['@scope' => $data['report_scope']])];
  if ($customUrl !== NULL) {
    // The URL may carry a user name or password: it is not repeated.
    \Drupal::logger('sentinel_connector')->warning('The saved Sentinel API base URL was not the production default and was removed. Set the @settings setting in settings.php or the @env environment variable on this environment, or the site sends to @default.', [
      '@settings' => ApiBaseUrlResolver::SETTINGS_KEY,
      '@env' => ApiBaseUrlResolver::ENV_VAR,
      '@default' => ApiBaseUrlResolver::DEFAULT_URL,
    ]);
    $messages[] = (string) t('The saved Sentinel API base URL was not the production default and was removed. Set the @settings setting in settings.php or the @env environment variable on this environment, or the site sends to @default.', [
      '@settings' => ApiBaseUrlResolver::SETTINGS_KEY,
      '@env' => ApiBaseUrlResolver::ENV_VAR,
      '@default' => ApiBaseUrlResolver::DEFAULT_URL,
    ]);
  }
  return implode(' ', $messages);
}
