parameters:
  level: 6
  paths:
    - src
    - tests
    - sentinel_connector.module
    - sentinel_connector.install
  ignoreErrors:
    # Drupal 11 requires this attribute; PHPUnit 9 on Drupal 10 has no class.
    # PHP 8 ignores uninstantiated attributes, so both runtimes remain valid.
    - message: '#^Attribute class PHPUnit\\Framework\\Attributes\\RunTestsInSeparateProcesses does not exist\.$#'
      path: tests/src/Kernel/*Test.php
      reportUnmatched: false
