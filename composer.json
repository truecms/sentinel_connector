{
    "name": "drupal/sentinel_connector",
    "description": "Drupal 10/11/12 module that reports installed extensions to the Sentinel monitoring platform.",
    "type": "drupal-module",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.3",
        "drupal/core": "^10.3 || ^11 || ^12",
        "ext-json": "*"
    },
    "require-dev": {
        "justinrainbow/json-schema": "^5.2 || ^6.0",
        "drush/drush": "^12.5 || ^13 || ^14",
        "drupal/coder": "^8.3 || ^9.0",
        "squizlabs/php_codesniffer": "^3.7 || ^4.0",
        "mglaman/phpstan-drupal": "^1.2 || ^2.0",
        "phpstan/extension-installer": "^1.3"
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
