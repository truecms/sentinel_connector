<?php

/**
 * @file
 * Sentinel Connector — reports installed extensions to Sentinel.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\sentinel_connector\Hook\SentinelHooks;

/**
 * Implements hook_cron() for Drupal versions without object-oriented hooks.
 */
#[LegacyHook]
function sentinel_connector_cron(): void {
  (new SentinelHooks(\Drupal::getContainer()))->cron();
}

/**
 * Implements hook_modules_installed() for Drupal versions without OOP hooks.
 *
 * @param string[] $modules
 *   The modules just installed.
 */
#[LegacyHook]
function sentinel_connector_modules_installed(array $modules): void {
  (new SentinelHooks(\Drupal::getContainer()))->modulesInstalled($modules);
}
