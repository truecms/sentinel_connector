{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "DrupalSiteSync",
    "type": "object",
    "required": [
        "site",
        "drupal_info",
        "modules",
        "full_sync"
    ],
    "additionalProperties": false,
    "properties": {
        "site": {
            "type": "object",
            "required": [
                "url",
                "name",
                "uuid"
            ],
            "additionalProperties": false,
            "properties": {
                "url": {
                    "type": "string",
                    "minLength": 1
                },
                "name": {
                    "type": "string",
                    "minLength": 1
                },
                "token": {
                    "type": "string"
                },
                "uuid": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
                }
            }
        },
        "drupal_info": {
            "type": "object",
            "required": [
                "core_version",
                "php_version",
                "ip_address"
            ],
            "additionalProperties": false,
            "properties": {
                "core_version": {
                    "type": "string",
                    "minLength": 1
                },
                "php_version": {
                    "type": "string",
                    "minLength": 1
                },
                "ip_address": {
                    "type": "string",
                    "minLength": 1
                }
            }
        },
        "modules": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "machine_name",
                    "display_name",
                    "module_type",
                    "enabled",
                    "version"
                ],
                "additionalProperties": false,
                "properties": {
                    "machine_name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "display_name": {
                        "type": "string",
                        "minLength": 1
                    },
                    "module_type": {
                        "type": "string",
                        "enum": [
                            "contrib",
                            "custom",
                            "core"
                        ]
                    },
                    "enabled": {
                        "type": "boolean"
                    },
                    "version": {
                        "type": "string",
                        "minLength": 1
                    },
                    "description": {
                        "type": [
                            "string",
                            "null"
                        ]
                    },
                    "reported_project": {
                        "type": [
                            "string",
                            "null"
                        ],
                        "maxLength": 128,
                        "pattern": "^[a-z0-9_]+$"
                    },
                    "version_known": {
                        "type": "boolean"
                    }
                }
            }
        },
        "full_sync": {
            "type": "boolean"
        },
        "inventory_scope": {
            "type": "string",
            "enum": [
                "all",
                "contrib_custom",
                "contrib"
            ]
        },
        "connector_version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "platform": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "php": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        },
                        "sapi": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        }
                    }
                },
                "web_server": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "software": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        },
                        "raw": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 255
                        }
                    }
                },
                "database": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "driver": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        },
                        "product": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        },
                        "version": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        }
                    }
                },
                "os": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                        "family": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        },
                        "distribution": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        },
                        "release": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 50
                        }
                    }
                }
            }
        },
        "config_drift": {
            "type": "object",
            "required": [
                "status",
                "reason",
                "generated_at",
                "total",
                "config_pr_enabled",
                "truncated",
                "objects"
            ],
            "additionalProperties": false,
            "oneOf": [
                {
                    "properties": {
                        "status": {
                            "enum": [
                                "complete"
                            ]
                        },
                        "reason": {
                            "type": "null"
                        }
                    }
                },
                {
                    "properties": {
                        "status": {
                            "enum": [
                                "incomplete"
                            ]
                        },
                        "reason": {
                            "enum": [
                                "time_budget"
                            ]
                        }
                    }
                },
                {
                    "properties": {
                        "status": {
                            "enum": [
                                "unavailable"
                            ]
                        },
                        "reason": {
                            "enum": [
                                "sync_directory_missing",
                                "sync_unreadable",
                                "error",
                                "disabled"
                            ]
                        },
                        "total": {
                            "enum": [
                                0
                            ]
                        },
                        "truncated": {
                            "enum": [
                                false
                            ]
                        },
                        "objects": {
                            "maxItems": 0
                        }
                    }
                }
            ],
            "properties": {
                "status": {
                    "type": "string",
                    "enum": [
                        "complete",
                        "incomplete",
                        "unavailable"
                    ]
                },
                "reason": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "sync_directory_missing",
                        "sync_unreadable",
                        "time_budget",
                        "error",
                        "disabled",
                        null
                    ]
                },
                "generated_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "total": {
                    "type": "integer",
                    "minimum": 0
                },
                "config_pr_enabled": {
                    "type": "boolean"
                },
                "truncated": {
                    "type": "boolean"
                },
                "objects": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "collection",
                            "change"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 250
                            },
                            "collection": {
                                "type": "string",
                                "maxLength": 250
                            },
                            "change": {
                                "type": "string",
                                "enum": [
                                    "create",
                                    "update",
                                    "delete",
                                    "rename"
                                ]
                            }
                        }
                    }
                },
                "export_pull_request": {
                    "type": "object",
                    "required": [
                        "url",
                        "updated_at"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "url": {
                            "type": "string",
                            "format": "uri",
                            "pattern": "^https?://",
                            "maxLength": 2048
                        },
                        "updated_at": {
                            "type": "string",
                            "format": "date-time",
                            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                        }
                    }
                }
            }
        },
        "upgrade_status": {
            "type": "object",
            "required": [
                "module_version",
                "current_major",
                "target_major",
                "status",
                "projects_total",
                "counts",
                "custom_not_ready",
                "reason",
                "newest_scan_at",
                "oldest_scan_at",
                "generated_at"
            ],
            "additionalProperties": false,
            "oneOf": [
                {
                    "properties": {
                        "status": {
                            "enum": [
                                "ready",
                                "not_ready",
                                "incomplete",
                                "not_scanned"
                            ]
                        },
                        "reason": {
                            "type": "null"
                        }
                    }
                },
                {
                    "properties": {
                        "status": {
                            "enum": [
                                "unavailable"
                            ]
                        },
                        "reason": {
                            "enum": [
                                "service_missing",
                                "unsupported_api",
                                "unexpected_data",
                                "error"
                            ]
                        },
                        "projects_total": {
                            "enum": [
                                0
                            ]
                        },
                        "custom_not_ready": {
                            "enum": [
                                0
                            ]
                        },
                        "newest_scan_at": {
                            "type": "null"
                        },
                        "oldest_scan_at": {
                            "type": "null"
                        }
                    }
                }
            ],
            "properties": {
                "module_version": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 50,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_-]*$"
                },
                "current_major": {
                    "type": "integer",
                    "minimum": 8,
                    "maximum": 99
                },
                "target_major": {
                    "type": "integer",
                    "minimum": 9,
                    "maximum": 100
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "ready",
                        "not_ready",
                        "incomplete",
                        "not_scanned",
                        "unavailable"
                    ]
                },
                "projects_total": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                },
                "counts": {
                    "type": "object",
                    "required": [
                        "relax",
                        "update",
                        "collaborate",
                        "rector",
                        "manual",
                        "remove",
                        "scan"
                    ],
                    "additionalProperties": false,
                    "properties": {
                        "relax": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                        },
                        "update": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                        },
                        "collaborate": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                        },
                        "rector": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                        },
                        "manual": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                        },
                        "remove": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                        },
                        "scan": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 100000
                        }
                    }
                },
                "custom_not_ready": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 100000
                },
                "reason": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "enum": [
                        "service_missing",
                        "unsupported_api",
                        "unexpected_data",
                        "error",
                        null
                    ]
                },
                "newest_scan_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "oldest_scan_at": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                },
                "generated_at": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                }
            }
        },
        "schema_version": {
            "type": "integer",
            "enum": [
                1,
                2,
                3,
                4
            ]
        }
    }
}
